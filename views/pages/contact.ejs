<% layout("/layouts/boilerplate") %> <% style="contact" %>

<header class="banner">
  <p class="bannerHeading">GET IN TOUCH</p>
  <p class="desc">We're here to help you with your healthcare journey.</p>
  <div class="desc">Feel free to reach out to us.</div>
</header>

<button id="topBtn">&uparrow;</button>

<main class="mainContent">
  <section class="formCon">
    <form action="" class="form">
      <p class="headline">Send us a Message</p>
      <div class="formInner">
        <label for="name">
          Name:
          <input
            type="text"
            placeholder="Enter your full name"
            class="input"
            id="name"
            name="name"
          />
        </label>
        <div class="samePart">
          <label for="email">
            Email Address:
            <input
              type="email"
              placeholder="Enter your email address"
              class="input"
              id="email"
              name="email"
            />
          </label>
          <label for="number">
            Phone Number:
            <input
              type="text"
              placeholder="Enter your phone number"
              class="input"
              id="number"
              name="number"
            />
          </label>
        </div>
        <label for="subject">
          Subject:
          <input
            type="text"
            placeholder="Subject"
            class="input"
            id="subject"
            name="subject"
          />
        </label>
        <br /><br />
        <label for="message">
          Message:
          <br />
          <textarea
            placeholder="Write Message..."
            class="textarea"
            id="message"
            name="message"
          ></textarea>
        </label>
        <br />
        <input type="checkbox" name="terms" id="terms" checked />
        <label for="terms">I agree the terms &amp; conditions.</label>
        <br />
        <div class="btns">
          <button type="reset" class="btnR">Reset</button>
          <button type="submit" class="btn">Send Message &rarr;</button>
        </div>
        <p class="successMsg" id="successMsg"></p>
      </div>
    </form>
  </section>

  <section class="contact">
    <p class="headline">Contact Information</p>
    <h4><i class="fa-regular fa-envelope"></i>&nbsp; Email:</h4>
    <p>
      supportintelliphoenix@gmail.com, <br />
      support@intelliphoenix.com, <br />
      intelliphoenix@support.com
    </p>
    <h4><i class="fa-solid fa-phone"></i>&nbsp; Phone:</h4>
    <p>+91 XXXXX XXXXX</p>
    <h4><i class="fa-solid fa-location-dot"></i>&nbsp; Address:</h4>
    <p>Gorakhpur, Uttar Pradesh, India</p>
    <h4><i class="fa-solid fa-clock"></i>&nbsp; Working Hours</h4>
    <p>Sunday &dash; Saturday</p>
    <p>Time: 24/7</p>

    <p class="headline">Follow Us</p>
    <div class="socialLinks">
      <i class="fa-brands fa-facebook"></i>
      <i class="fa-brands fa-square-instagram"></i>
      <i class="fa-brands fa-linkedin"></i>
      <i class="fa-brands fa-youtube"></i>
    </div>
  </section>
</main>

<div class="gapping"></div>
<div class="gapping"></div>

<script src="js/contact.js"></script>
