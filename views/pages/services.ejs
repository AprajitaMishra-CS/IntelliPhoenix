<% layout("/layouts/boilerplate") %> <% style="services" %>

<button id="topBtn">&uparrow;</button>

<header>
  <p class="heading">Our Services</p>
  <p class="subheadLine">
    Comprehensive healthcare support powered by AI and trusted professionals.
  </p>
</header>

<div class="gapping"></div>

<main class="mainContent">
  <section class="firstCon">
    <div class="card">
      <div class="ImgDiv">
        <img src="assests/AI-Powered.png" class="card-img" />
      </div>
      <p class="cardHeading"><b>AI Symptom Analysis</b></p>
      <p class="cardDesc">
        Describe your symptoms and receive AI-assisted health insights.
      </p>
    </div>
    <div class="card">
      <div class="ImgDiv">
        <img src="assests/Doctor.png" class="card-img" />
      </div>
      <p class="cardHeading"><b>Doctor Recommendation</b></p>
      <p class="cardDesc">
        Find the most suitable specialist based on your symptoms.
      </p>
    </div>
    <div class="card">
      <div class="ImgDiv">
        <img src="assests/Appointment.png" class="card-img" />
      </div>
      <p class="cardHeading"><b>Appointment Booking</b></p>
      <p class="cardDesc">
        Book appointments with specialists in just a few clicks.
      </p>
    </div>
  </section>
  <br />
  <section class="firstCon">
    <div class="card">
      <div class="ImgDiv">
        <img src="assests/dashboard.png" class="card-img" />
      </div>
      <p class="cardHeading"><b>Health Dashboard</b></p>
      <p class="cardDesc">Track appointments and reports from one place.</p>
    </div>
    <div class="card">
      <div class="ImgDiv">
        <img src="assests/ECGHeart.png" class="card-img" />
      </div>
      <p class="cardHeading"><b>AI Health Assistance</b></p>
      <p class="cardDesc">Get answers to general healthcare questions.</p>
    </div>
    <div class="card">
      <div class="ImgDiv">
        <img src="assests/notification.png" class="card-img" />
      </div>
      <p class="cardHeading"><b>In App Notification</b></p>
      <p class="cardDesc">Notification about appoitment in App.</p>
    </div>
  </section>
  <br />
  <section class="firstCon">
    <div class="card">
      <div class="ImgDiv">
        <img src="assests/report.png" class="card-img" />
      </div>
      <p class="cardHeading"><b>Digital Health Reports</b></p>
      <p class="cardDesc">Access and manage your reports securely.</p>
    </div>
    <div class="card">
      <div class="ImgDiv">
        <img src="assests/emergency.png" class="card-img" />
      </div>
      <p class="cardHeading"><b>Emergency Support</b></p>
      <p class="cardDesc">Quick access to Emergency contacts.</p>
    </div>
  </section>
</main>

<div class="disclaimer">
  &ast; Disclaimer: The AI responses generated by the system are informational
  only and do not replace professional medical diagnosis or consultation.
</div>

<script src="/js/services.js"></script>
