<% layout("/layouts/boilerplate") %> <% style="login" %>
<div class="gapping"></div>

<main class="mainContent">
  <section class="formCon">
    <div class="gapping"></div>

    <form action="" method="" class="form">
      <div class="startForm">
        <img src="assests/logo.png" class="formLogo" />
        <h2>WELCOME BACK !!</h2>
        <p class="subheading">Login to continue your healthcare journey</p>
      </div>

      <div class="formInner">
        <label for="email">
          <i class="fa-regular fa-envelope"></i> Email:
          <input
            type="email"
            placeholder="Enter your email address"
            class="input"
            id="email"
            name="email"
          />
        </label>
        <br /><br />
        <label for="subject">
          <i class="fa-solid fa-lock"></i> Password:
          <input
            type="password"
            placeholder="Enter password"
            class="input"
            id="pswd"
            name="pswd"
          />
        </label>
        <br /><br />
        <div class="remForget">
          <input type="checkbox" name="terms" id="terms" checked />
          <label for="terms">Remember Me</label>
          <a href="">Forget Password?</a>
        </div>
        <br />
        <div class="btns">
          <button type="submit" class="btn">Login &rightarrow;</button>
        </div>
        <div class="divider">
          <div class="hrTag"><hr /></div>
          <span>OR</span>
          <div class="hrTag"><hr /></div>
        </div>
        <div class="optionals">
          <button class="option">
            <i class="fa-brands fa-google"></i> Continue with Google
          </button>
          <p class="dont">
            Don't have an account? <a href="register.html">Register</a>
          </p>
        </div>
      </div>
    </form>
  </section>
</main>

<div class="gapping"></div>

<script src="/js/login.js"></script>
