<% layout("/layouts/boilerplate") %> <% style="index" %>

<header class="heroSection">
  <div class="banner">
    <div class="startHeroSection">
      <span
        ><img src="assests/diamond.png" class="diamondLogo" /> AI-Powered
        Healthcare</span
      >
    </div>
    <p class="bannerHeading">
      IntelliPh<img src="assests/logo.png" class="titleMidLogo" />enix
    </p>
    <!--MediAssist,IntelliVita,IntelliCure,CuraNova-->
    <p class="subheading">Where Intelligence Inspires Recovery</p>
    <p class="headline hL1"><b>Smarter Care,</b></p>
    <p class="headline hL2"><b>Better Health.</b></p>
    <p class="desc">
      Understand your symptoms, get possible insights, book appointments, <br />
      receive expert recommendations, and manage your health &mdash; all in one
      place.
    </p>
    <div class="starterBtn">
      <div class="starter link">
        <a href="/register">Start Your Healthcare Journey &rightarrow;</a>
      </div>
      <div class="starter read">
        <a href="/about">Read More...</a>
      </div>
    </div>
    <div class="extraDetails">
      <div class="firstDetail">
        <img src="assests/shield.png" />
        <div class="data">
          <p class="firstData">Your Data, Our Priority</p>
          <p class="secData">Secure & Private</p>
        </div>
      </div>
      <div class="secondDetail">
        <img src="assests/people.png" />
        <div class="data">
          <p class="firstData">AI-Assisted Insights</p>
          <p class="secData">Not a replacement for doctor</p>
        </div>
      </div>
      <div class="thirdDetail">
        <img src="assests/clock.png" />
        <div class="data">
          <p class="firstData">Available 24/7</p>
          <p class="secData">Anytime, Anywhere</p>
        </div>
      </div>
    </div>
    <div class="tags">
      PEOPLE &nbsp;&bull;&nbsp; TECHNOLOGY &nbsp;&bull;&nbsp; A HEALTHIER
      TOMORROW
    </div>
  </div>
  <div>
    <img src="assests/heroSectionImg.png" class="heroSecLogo" />
  </div>
</header>

<div class="gapping"></div>

<main class="mainContent">
  <div class="why">
    <span>Why Choose IntelliPhoenix ?</span>
  </div>
  <div class="secondLine">
    <h2>Everything You Need for Better Healthcare</h2>
  </div>
  <section class="firstCon">
    <div class="card">
      <div class="graphics first-graphics">
        <img src="assests/brainCircuit.png" class="card-img" />
      </div>
      <!-- <hr /> -->
      <h4>AI Symptom Analysis</h4>
      <p>
        Advanced AI analyzes your symptoms and predicts possible conditions with
        accuracy.
      </p>
    </div>
    <div class="card">
      <div class="graphics second-graphics">
        <img src="assests/Doctor.png" class="card-img" />
      </div>
      <!-- <hr /> -->
      <h4>Find Specialists</h4>
      <p>Connect with top doctors across various specializations.</p>
    </div>
    <div class="card">
      <div class="graphics third-graphics">
        <img src="assests/calendar.png" class="card-img" />
      </div>
      <!-- <hr /> -->
      <h4>Book Appointment</h4>
      <p>Book appointments with verified specialists in just few clicks.</p>
    </div>
    <div class="card">
      <div class="graphics fourth-graphics">
        <img src="assests/report.png" class="card-img" />
      </div>
      <!-- <hr /> -->
      <h4>Digital Reports</h4>
      <p>
        Store and manage your reports, prescriptions, and medical history
        securely.
      </p>
    </div>
    <div class="card">
      <div class="graphics fifth-graphics">
        <img src="assests/ECGHeart.png" class="card-img" />
      </div>
      <!-- <hr /> -->
      <h4>Health Insights</h4>
      <p>Get personalized health insights and recommendations.</p>
    </div>
  </section>

  <button id="topBtn">&uparrow;</button>

  <div class="gapping"></div>

  <div class="hrTag"><hr /></div>

  <div class="gapping"></div>

  <div class="why">
    <span>Simple & Fast</span>
  </div>
  <div class="secondLine">
    <h2>How It Works</h2>
  </div>
  <section class="secCon">
    <div class="workIcon">
      <div class="stepLogo sL sLColor1 step-Card">
        <img src="assests/Account.png" class="counter-img" />
      </div>
      <div class="workDescription">
        <b>Step 1: Create Your Account</b>
        <p>
          Create account to access personalized healthcare services &amp; manage
          health information.
        </p>
      </div>
    </div>

    <div class="sign">
      <img src="assests/connectingLine.png" class="signLogo" />
      <!-- <p>&SmallCircle;&dash;&SmallCircle;</p> -->
    </div>

    <div class="workIcon">
      <div class="stepLogo sL sLColor2 step-Card">
        <img src="assests/Magnifying.png" class="counter-img" />
      </div>
      <div class="workDescription">
        <b>Step 2: Describe Your Symptoms</b>
        <p>
          Enter your symptoms, duration, and other relevant details for
          analysis.
        </p>
      </div>
    </div>

    <div class="sign">
      <img src="assests/connectingLine.png" class="signLogo" />
    </div>

    <div class="workIcon">
      <div class="stepLogo sL sLColor3 step-Card">
        <img src="assests/AI-Powered.png" class="counter-img" />
      </div>
      <div class="workDescription">
        <b>Step 3: Get AI-Powered Analysis</b>
        <p>
          AI analyzes your symptoms and provides possible conditions and useful
          health insights.
        </p>
      </div>
    </div>

    <div class="sign">
      <img src="assests/connectingLine.png" class="signLogo" />
    </div>

    <div class="workIcon">
      <div class="stepLogo sL sLColor4 step-Card">
        <img src="assests/Doctor.png" class="counter-img" />
      </div>
      <div class="workDescription">
        <b>Step 4: Receive Guidance </b>
        <p>
          Receive precautions and suggested medical specialists based on your
          reported symptoms.
        </p>
      </div>
    </div>
  </section>
  <p class="disclaimer">
    &ast; IntelliPhoenix provides AI-generated health insights for informational
    purpose only. AI result are not a medical diagnosis and should not replace
    professional medical consultation.
  </p>

  <div class="gapping"></div>

  <div class="hrTag"><hr /></div>

  <div class="gapping"></div>

  <section class="features">
    <div class="secondLine">
      <h2>Features</h2>
    </div>
    <section class="firstCon">
      <div class="card">
        <h4>1.<br />AI Symptom Checker</h4>
      </div>
      <div class="card">
        <h4>2.<br />Appointment Booking</h4>
      </div>
      <div class="card">
        <h4>3.<br />Doctor Recommendation</h4>
      </div>
      <div class="card">
        <h4>4.<br />Digital Reports</h4>
      </div>
      <div class="card">
        <h4>5.<br />Precautions</h4>
      </div>
      <div class="card">
        <h4>6.<br />Severity Level</h4>
      </div>
    </section>
  </section>

  <div class="gapping"></div>

  <div class="gapping"></div>

  <div class="countersDir">
    <div class="wholeCounter">
      <div class="counterLogo-1 cL">
        <img src="assests/patient.png" class="counter-img" />
      </div>
      <div class="counter">
        <h2 class="count" data-target="2500">0</h2>
        <p>Patients</p>
      </div>
    </div>

    <div class="wholeCounter">
      <div class="counterLogo-2 cL">
        <img src="assests/Doctor.png" class="counter-img" />
      </div>
      <div class="counter">
        <h2 class="count" data-target="120">0</h2>
        <p>Doctors</p>
      </div>
    </div>

    <div class="wholeCounter">
      <div class="counterLogo-3 cL">
        <img src="assests/Appointment.png" class="counter-img" />
      </div>
      <div class="counter">
        <h2 class="count" data-target="850">0</h2>
        <p>Appointments</p>
      </div>
    </div>

    <div class="wholeCounter">
      <div class="counterLogo-4 cL">
        <img src="assests/Accuracy.png" class="counter-img" />
      </div>
      <div class="counter">
        <h2 class="count" data-target="95">0</h2>
        <p>Accuracy</p>
      </div>
    </div>
  </div>

  <div class="gapping"></div>
</main>

<script src="/js/index.js"></script>
