<% layout("/layouts/boilerplate") %> <% style="index" %>

<header class="banner">
  <p class="bannerHeading">
    IntelliPh<img src="assests/logo.png" class="titleMidLogo" />enix
  </p>
  <!--MediAssist,IntelliVita,IntelliCure,CuraNova-->
  <p class="subheading">Where Intelligence Inspires Recovery</p>
  <p class="desc">
    AI-Powered healthcare for symptom analysis, appointment booking, precautions
    guidance and smart healthcare management.
  </p>
  <div class="starter">
    <a href="register.html">Get Started &rightarrow;</a>
  </div>
</header>

<div class="gapping"></div>

<main class="mainContent">
  <h3>WHY CHOOSE INTELLIPHOENIX ?</h3>
  <section class="firstCon">
    <div class="card">
      <img src="assests/symptoms.jpg" class="card-img" />
      <hr />
      <h5>AI Symptom Analysis</h5>
      <p>Analyze symptoms using AI assistance.</p>
    </div>
    <div class="card">
      <img src="assests/specialist.jpg" class="card-img" />
      <hr />
      <h5>Find Specialists</h5>
      <p>Get recommended doctors.</p>
    </div>
    <div class="card">
      <img src="assests/bookappoint.jpg" class="card-img" />
      <hr />
      <h5>Book Appointment</h5>
      <p>Schedule appointments easily.</p>
    </div>
    <div class="card">
      <img src="assests/report.jpg" class="card-img" />
      <hr />
      <h5>Digital Reports</h5>
      <p>Access AI-generated reports anytime.</p>
    </div>
  </section>

  <button id="topBtn">&uparrow;</button>

  <div class="gapping"></div>

  <div class="hrTag"><hr /></div>

  <div class="gapping"></div>

  <h3>HOW IT WORKS ?</h3>
  <section class="secCon">
    <div class="Work">
      <p>
        <b>Step 1:</b> Create Account.
        <i class="fa-regular fa-circle-user"></i>
      </p>
      <!-- &downarrow; -->
      <p>
        <b>Step 2:</b> Go to Dashboard.
        <i class="fa-brands fa-dashcube"></i>
      </p>
      <!-- &downarrow; -->
      <p>
        <b>Step 3:</b> Click on AI Assistance Chat.
        <i class="fa-regular fa-comment"></i>
      </p>
      <!-- &downarrow; -->
      <p>
        <b>Step 4:</b> Describe Symptoms.
        <i class="fa-solid fa-bed-pulse"></i>
      </p>
      <!-- &downarrow; -->
      <p>
        <b>Step 5:</b> AI-assisted responses such as possible health concerns,
        severity levels, basic precautions, and specialist recommendations.
        <i class="fa-solid fa-user-doctor"></i>
      </p>
    </div>
  </section>
  <p class="disclaimer">
    * You can get report of AI response and can book appointment.
  </p>

  <div class="gapping"></div>

  <div class="hrTag"><hr /></div>

  <div class="gapping"></div>

  <section class="features">
    <h3>FEATURES</h3>
    <section class="firstCon">
      <div class="card">
        <h5>1.<br />AI Symptom Checker</h5>
      </div>
      <div class="card">
        <h5>2.<br />Appointment Booking</h5>
      </div>
      <div class="card">
        <h5>3.<br />Doctor Recommendation</h5>
      </div>
      <div class="card">
        <h5>4.<br />Digital Reports</h5>
      </div>
      <div class="card">
        <h5>5.<br />Precautions</h5>
      </div>
      <div class="card">
        <h5>6.<br />Severity Level</h5>
      </div>
    </section>
  </section>

  <div class="gapping"></div>

  <div class="hrTag"><hr /></div>

  <div class="gapping"></div>

  <section class="countersDir">
    <div class="counter">
      <h2 class="count" data-target="2500">0</h2>
      <p>Patients</p>
    </div>
    <div class="counter">
      <h2 class="count" data-target="120">0</h2>
      <p>Doctors</p>
    </div>
    <div class="counter">
      <h2 class="count" data-target="850">0</h2>
      <p>Appointments</p>
    </div>
    <div class="counter">
      <h2 class="count" data-target="95">0</h2>
      <p>Accuracy</p>
    </div>
  </section>

  <div class="gapping"></div>
</main>

<script src="/js/index.js"></script>
